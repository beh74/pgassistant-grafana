      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "pgassistant_repository"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_snapshot AS (\n  SELECT DISTINCT ON (g.target_id) g.target_id, g.run_id, g.collected_at\n  FROM pga_global_advisor_snapshot g\n  LEFT JOIN pga_collection_run r ON r.run_id = g.run_id\n  WHERE $__timeFilter(g.collected_at)\n    AND coalesce(r.environment, 'unknown') IN (${environment:sqlstring})\n    AND g.target_id IN (${target_id:sqlstring})\n  ORDER BY g.target_id, g.collected_at DESC\n),\ncurrent_findings AS (\n  SELECT g.*, coalesce(r.environment, 'unknown') AS environment\n  FROM pga_global_advisor_snapshot g\n  JOIN latest_snapshot ls ON ls.target_id = g.target_id AND ls.run_id = g.run_id\n  LEFT JOIN pga_collection_run r ON r.run_id = g.run_id\n  WHERE coalesce(g.category_id, 'UNKNOWN') IN (${category_id:sqlstring})\n    AND coalesce(g.advisor_group, 'UNKNOWN') IN (${advisor_group:sqlstring})\n    AND coalesce(g.object_type, 'UNKNOWN') IN (${object_type:sqlstring})\n    AND coalesce(g.priority, 'UNKNOWN') IN (${priority:sqlstring})\n)\nSELECT environment, count(DISTINCT target_id) AS databases, count(*) AS findings,\n       count(*) FILTER (WHERE priority = 'HIGH') AS high_priority,\n       count(*) FILTER (WHERE risk_level = 'HIGH') AS high_risk,\n       count(*) FILTER (WHERE action_safety = 'MANUAL_ONLY') AS manual_only,\n       count(*) FILTER (WHERE requires_lock IS TRUE) AS requires_lock,\n       count(*) FILTER (WHERE requires_maintenance_window IS TRUE) AS maintenance_window,\n       max(collected_at) AS last_collected_at\nFROM current_findings\nGROUP BY environment\nORDER BY high_priority DESC, high_risk DESC, findings DESC;",
          "refId": "A"
        }
      ],
      "title": "Latest summary by environment",
      "type": "table"
    },
