          "rawQuery": true,
          "rawSql": "SELECT\n  g.target_id,\n  g.label,\n  g.recommendation_note,\n  count(*) AS occurrences,\n  max(g.collected_at) AS last_collected_at\nFROM pga_global_advisor_snapshot g\nWHERE $__timeFilter(g.collected_at)\n  AND g.recommendation_id IS NOT NULL\n  AND g.recommendation_id IN (${recommendation_id:sqlstring})\nGROUP BY g.target_id, g.label, g.recommendation_note\nORDER BY occurrences DESC, g.target_id, g.label\nLIMIT 100;",
